      let updatedModels: string[];
      if (checked) {
        updatedModels = existingModels.includes(model) ? existingModels : [...existingModels, model];
      } else {
        updatedModels = existingModels.filter(m => m !== model);
      }

      item.STATUS = item?.STATUS === "ADD" ? "ADD" : "UPDATE";

      return {
        ...item,
        SELECTED_MODELS: updatedModels.join(",")
