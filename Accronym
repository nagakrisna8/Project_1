// Cheap HTML -> plain text (for cell tooltip title), cached by string. Replaces
// `new DOMParser().parseFromString(...)` which ran per row on EVERY grid render
// (e.g. after each dropdown selection), adding to the post-select delay.
const htmlToTextCache = new Map<string, string>();
let htmlToTextEl: HTMLDivElement | null = null;
const htmlToPlainText = (html: string | null | undefined): string => {
  if (!html) return "";
  const cached = htmlToTextCache.get(html);
  if (cached !== undefined) return cached;
  if (!htmlToTextEl) htmlToTextEl = document.createElement("div");
  htmlToTextEl.innerHTML = html;
  const text = htmlToTextEl.textContent ?? "";
  if (htmlToTextCache.size > 2000) htmlToTextCache.clear();
  htmlToTextCache.set(html, text);
  return text;
};

