    const field = columnData.field;
    const [data, setData] = useState(props.dataItem[field]);
    const rowError = field === "CRI" ? errors[props.dataItem.Cri_Id] : "";

    const saveChanges: React.ChangeEventHandler<HTMLInputElement> = (e) => {
      setData(e.target.value);


      if (props.onChange) {
        props.onChange({
          dataIndex: props.dataIndex,
          dataItem: { ...props.dataItem, [field]: e.target.value },
          syntheticEvent: e,
          field: field,
          value: e.target.value
        });
      }

      if (e.target.value.trim()) {
        setErrors(prev => {
          const copy = { ...prev };
          delete copy[props.dataItem.Cri_Id];
          return copy;
        });
      }
    }


    return type === CriType.PROJECT && props.dataItem?.STATUS === "ADD"
      ?
      (
        <td className="cri-columns" style={columnData.style}>
          <input
            style={{ width: "100%", padding: "4px", paddingLeft: "6px", borderRadius: "4px", border: rowError ? "1px solid red" : "1px solid #cacaca", outline: "none", boxSizing: "border-box" }}
            value={data || ""}
            onChange={(e) => {
              setData(e.target.value)
            }}
            onBlur={saveChanges}
            maxLength={columnData.title === 'CRI Number' ? 100 : 500}
            required={true}
            placeholder={`Enter ${columnData.title}`}
          />
        </td>) :
      (
        <td className="cri-columns" title={props.dataItem[field]} style={columnData.style}>
          {props.dataItem[field]}
        </td>
      )
  };




