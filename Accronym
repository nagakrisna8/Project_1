                      field: "Description",
                      title: "Description",
                      style: { minWidth: "300px", textWrap: 'nowrap', textOverflow: 'ellipsis', overflow: 'hidden' }
                    }}
                  // isStatusArchive={isStatusArchive}
                  />
                )}
              />
              :
              <GridColumn
                {...columnProps("Description")}
                field="Description"
                title="Name"
                width="300px"
                cell={(props) => (
                  // <td className="cri-columns" style={{ minWidth: "300px" }} title={props.dataItem.Description}>
                  //   {props.dataItem.Description}
                  // </td>
                  <CustomColumnCell
                    {...props}
                    columnData={{
                      field: "Description",
                      title: "Description",
                      style: { minWidth: "300px", textWrap: 'nowrap', textOverflow: 'ellipsis', overflow: 'hidden' }
                    }}


                  // isStatusArchive={isStatusArchive}
                  />
                )}
              />
          }

          <GridColumn title="Applicability">
            {criMappingGridData?.Models?.map(def => {
              let title = "";
              const split = def.split("-");
              if (split.length > 1) {
                const split2 = split[1].trim().split(" ");
                title = "-" + split2[0];
              } else {
                title = def;
              }
              return (
                <GridColumn
                  width="110px"
                  key={def}
                  title={title}
                  field={def}
                  headerCell={makeHeaderCell(def)}
                  cell={(props: GridCellProps) => {
                    const currentId = (props.dataItem as CriListType).id;

                    const currentRow = criMappingGridData?.CRI_Data.find(
                      (item: CriListType) =>
                        item.id === currentId
                    );

                    const selectedModels =
                      currentRow?.SELECTED_MODELS
                        ?.split(",")
                        .map((model) => model.trim())
                        .filter(Boolean) ?? [];

                    const checked = selectedModels.includes(def);

                    return (
                      <td className="cri-columns" style={{ textAlign: 'left', paddingLeft: '9px' }}>
                        <input
                          key={`${currentId}-${def}`}
                          disabled={controlData?.cri_applicability?.page === "disable"}
                          type="checkbox"
                          checked={checked}
                          onChange={(e) => handleCheckboxChange(e, def, props.dataItem)}
                        />
                      </td>
                    );
                  }}
                />
              )
            })}
          </GridColumn>
        </DataGrid>
      </div>
    </div>
  );
}

