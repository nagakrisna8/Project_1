    if (!criMappingGridData) return;

    const updatedCriData = criMappingGridData.CRI_Data.map((item: CriListType) => {
      const existingModels = item.SELECTED_MODELS
        ? item.SELECTED_MODELS.split(",").map(m => m.trim()).filter(Boolean)
