  const handleCheckboxChange = (e: React.ChangeEvent<HTMLInputElement>, newModel: string, data: CriListType) => {
    const currentCheckedState = e.target.checked;
    if (!criMappingGridData) {
      return;
    }
    var gridData = [...criMappingGridData.CRI_Data];
    if (!gridData) {
      return gridData;
    }

    const updatedCriData = gridData.map(
      (item: CriListType) => {
        const isSameRow =
          item.id === data.id

        if (!isSameRow) {
          return item;
        }

        const existingModels = item.SELECTED_MODELS
          ? item.SELECTED_MODELS
            .split(",")
            .map((model) => model.trim())
            .filter(Boolean)
          : [];

        let updatedModels: string[];

        if (currentCheckedState) {
          // Add the model only if it does not already exist
          updatedModels = existingModels.includes(newModel)
            ? existingModels
            : [...existingModels, newModel];
        } else {
          // Remove only the unchecked model
          updatedModels = existingModels.filter(
            (model) => model !== newModel
          );
        }

        item.STATUS = item?.STATUS === "ADD" ? "ADD" : "UPDATE";

        return {
          ...item,
          SELECTED_MODELS: updatedModels.join(",")
        };
      }
    );

    const updatedData = {
      ...criMappingGridData,
      CRI_Data: updatedCriData,
      UserVisitingFlag: true,
      CRIFlag: true
    };

    setcriMappingGridData(updatedData);
    handleDirtyFlag(true);
  }


  function createCriId() {
    const criList = criMappingGridData?.CRI_Data?.map(c => c.id) || [];
    return Math.max(0, ...criList) + 1;
  }


  const validateData = (): boolean => {
    const newErrors: Record<number, string> = {};

    criMappingGridData?.CRI_Data?.forEach((item) => {
      if (!item.CRI?.trim()) {
        newErrors[item.Cri_Id] = "* CRI is required";
      }
    });

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };





  const addCRIData = () => {
    setcriMappingGridData((prev) => {
      if (!prev) return prev;

      const selectedModel =
        prev.Models?.length === 1 ? prev.Models[0] : "";

      const newCriData: CriListType = {
        id: createCriId(),
        Cri_Id: 0,
        CRI: "",
        Description: "",
        Cri_Type: CriType.PROJECT,
        SELECTED_MODELS: selectedModel,
        STATUS: "ADD"  // STATUS - we used only for cri_type PROJECT, so that we can identify them from others
      };

      return {
        ...prev,
        CRI_Data: [newCriData, ...prev.CRI_Data],
      };
    });
    handleDirtyFlag(true);
  };


  const saveCriData = async (showSnackbarFlag = true) => {
